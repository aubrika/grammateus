{
  "name": "grammateus",
  "version": "0.6.2",
  "private": true,
  "description": "Makes a folded, stapled Sunday bulletin as a print-ready PDF",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "pdf": "node tools/make_pdf.mjs",
    "test": "node --test",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.6.205"
  },
  "main": "electron/main.cjs",
  "author": "Aubrey",
  "build": {
    "appId": "org.grammateus.app",
    "productName": "Grammateus",
    "files": [
      "electron/**",
      "src/**",
      "examples/**",
      "build/icon.png",
      "package.json",
      "!node_modules/@napi-rs/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": false,
      "shortcutName": "Grammateus",
      "artifactName": "Grammateus-Setup-${version}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "bulletin",
        "name": "Bulletin",
        "description": "Grammateus bulletin",
        "role": "Editor"
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://raw.githubusercontent.com/aubrika/grammateus-releases/main/updates"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": "-",
      "artifactName": "Grammateus-${version}-mac.${ext}"
    },
    "dmg": {
      "title": "Grammateus ${version}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Office",
      "executableName": "grammateus",
      "maintainer": "aubrika <aubrika@users.noreply.github.com>",
      "synopsis": "Makes weekly church bulletins",
      "artifactName": "Grammateus-${version}-linux-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3"
  }
}
