{
  "name": "grammateus",
  "version": "0.5.2",
  "private": true,
  "description": "Makes a folded, stapled Sunday bulletin as a print-ready PDF",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "pdf": "node tools/make_pdf.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.6.205"
  },
  "main": "electron/main.cjs",
  "author": "Aubrey",
  "build": {
    "appId": "org.grammateus.app",
    "productName": "Grammateus",
    "files": [
      "electron/**",
      "src/**",
      "examples/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": false,
      "shortcutName": "Grammateus",
      "artifactName": "Grammateus-Setup-${version}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "bulletin",
        "name": "Bulletin",
        "description": "Grammateus bulletin",
        "role": "Editor"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "aubrika",
        "repo": "grammateus-releases"
      }
    ]
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3"
  }
}
